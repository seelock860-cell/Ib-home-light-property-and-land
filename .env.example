# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="MY_APP_URL"

# Supabase Configuration (Required for Production / Vercel Deployment)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional: Initial administrator password for local preview server provisioning
# Never commit real passwords to version control.
ADMIN_INITIAL_PASSWORD=""

# Optional: Secret used to sign admin session cookies in local/preview server mode
SESSION_SECRET=""
